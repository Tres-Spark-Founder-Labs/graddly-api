# Copy to `.env` locally. For staging/production secrets, see docs/secrets-checklist.md
#.env.example
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=graddly

# Application DB user. MUST be NOSUPERUSER NOBYPASSRLS, or row-level security
# is not enforced and every tenant-isolation policy in the database is inert.
# The API checks this on boot and logs a loud warning if it is not the case.
# Provision with: yarn db:provision-role
DB_USERNAME=graddly_app
DB_PASSWORD=
# TypeORM SQL logging (default: on in development, off otherwise). Set false to silence locally.
# DB_LOGGING_ENABLED=false

# Migrator / admin user for migrations and yarn db:provision-role (not used by
# the running API). This is the one deliberate superuser path.
#
# SET THIS EXPLICITLY. src/config/data-source.ts falls back to DB_USERNAME when
# it is blank, which would try to run DDL as the non-superuser app role.
#
# It must also match the role that ACTUALLY runs migrations: provisioning does
# ALTER DEFAULT PRIVILEGES FOR ROLE <this>, and Postgres only applies those to
# objects created by that same role. A mismatch means every new table is
# unreachable by the app with "permission denied" at runtime and nothing wrong
# at migration time. That happened in this repo -- see security pass item 2.
#
# For the docker-compose database below, the superuser is "graddly".
DB_MIGRATION_USERNAME=graddly
DB_MIGRATION_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_REUSE_GRACE_SECONDS=30

REDIS_HOST=localhost
REDIS_PORT=6379
# BullMQ queue key prefix (shared by API and worker processes)
BULLMQ_PREFIX=graddly

# Scheduled jobs run in the worker process only (not the HTTP API).
CRON_ENABLED=true
CRON_HEALTH_SCHEDULE=*/5 * * * *
# Redis lock so only one worker replica runs each cron tick (default TTL 240s)
CRON_LOCK_ENABLED=true
CRON_LOCK_TTL_SECONDS=240
# Background crons below default to false in development/test. When NODE_ENV is
# staging or production and a flag is unset, it defaults to true (PRD-022). Set
# explicit false to disable a cron in deployed environments.
# OTJ approval digest email (worker only). See docs/automation.md
# Runs daily; each manager's daily/weekly/off preference is applied at send
# time, so this must fire at least once a day for "daily" to mean anything.
CRON_DIGEST_ENABLED=false
CRON_DIGEST_SCHEDULE=0 8 * * *
# Zone the schedule is evaluated in. Europe/London keeps delivery at 08:00 UK
# time year-round; set UTC for a literal reading of the spec's "08:00 GMT",
# which lands at 09:00 UK time during British Summer Time.
CRON_DIGEST_TIMEZONE=Europe/London

# BullMQ failed-job inspection (API only). Requires X-Queue-Ops-Api-Key header.
QUEUE_OPS_ENABLED=false
QUEUE_OPS_API_KEY=

THROTTLE_ENABLED=true

# When true, sets PostgreSQL session GUCs (app.current_org, app.current_user, app.rls_bootstrap) before each ORM query for RLS policies.
TENANT_DB_CONTEXT_ENABLED=true

SWAGGER_PASSWORD=
LOGGLY_TOKEN=
LOGGLY_SUBDOMAIN=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# GOV.UK One Login (OIDC). See docs/oidc-one-login.md
OIDC_ENABLED=false
OIDC_ISSUER=https://oidc.integration.account.gov.uk
OIDC_DISCOVERY_URL=https://oidc.integration.account.gov.uk/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_SCOPES=openid email
OIDC_UI_LOCALES=en
OIDC_VTR=["Cl.Cm"]
OIDC_SESSION_SECRET=
OIDC_SESSION_TTL_SECONDS=600
OIDC_SUCCESS_REDIRECT_URI=
# auto_create | link_existing (default auto_create)
OIDC_PROVISIONING_MODE=auto_create

# Transactional email (Resend). See docs/password-reset.md and docs/email-verification.md
EMAIL_PROVIDER=noop
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_BASE_URL=http://localhost:3001
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
# Cap for Redis accept-token TTL (clamped to invitation expiresAt). Default 7d.
INVITATION_ACCEPT_TOKEN_TTL_SECONDS=604800

# File storage (S3). See docs/file-storage.md
STORAGE_PROVIDER=noop
AWS_REGION=eu-west-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGN_UPLOAD_TTL_SECONDS=900
S3_PRESIGN_DOWNLOAD_TTL_SECONDS=300

# PDF (Phase J) — pdfkit | noop
PDF_PROVIDER=pdfkit

# DAS (Phase L)
DAS_BASE_URL=
DAS_TOKEN_URL=
DAS_CLIENT_ID=
DAS_CLIENT_SECRET=
DAS_SCOPE=
DAS_LEVY_BALANCE_PATH=/api/levy/balance
DAS_LEVY_TRANSFER_CONSENT_PATH=/api/levy/transfers
DAS_LEVY_TRANSFER_STATUS_PATH=/api/levy/transfers
DAS_ENROLMENT_SUBMIT_PATH=/api/apprenticeships/enrolments
DAS_COMPLETION_NOTIFY_PATH=/api/apprenticeships/completions
DAS_FUNDING_PAYMENTS_PATH=/api/funding/payments

# Cross-portal enrolment flow (Phase 3)
ENROLMENT_AUTO_INVITE_APPRENTICE=true
DAS_TIMEOUT_MS=10000

# Donor DAS OAuth (Phase S — per-org consent, not client_credentials)
DAS_DONOR_OAUTH_AUTHORIZE_URL=
DAS_DONOR_OAUTH_TOKEN_URL=
DAS_DONOR_OAUTH_CLIENT_ID=
DAS_DONOR_OAUTH_CLIENT_SECRET=
DAS_DONOR_OAUTH_REDIRECT_URI=
DAS_DONOR_OAUTH_SCOPE=
DAS_DONOR_TOKEN_ENCRYPTION_KEY=

# DAS sync cron (worker only)
CRON_DAS_SYNC_ENABLED=false
CRON_DAS_SYNC_SCHEDULE=*/15 * * * *
CRON_DAS_FUNDING_SYNC_ENABLED=false
CRON_DAS_FUNDING_SYNC_SCHEDULE=0 2 * * *

# OTJ pace nightly cron (worker only)
CRON_OTJ_PACE_ENABLED=false
CRON_OTJ_PACE_SCHEDULE=0 1 * * *

# Review overdue + reminder crons (worker only)
CRON_REVIEW_OVERDUE_ENABLED=false
CRON_REVIEW_OVERDUE_SCHEDULE=0 2 * * *
CRON_REVIEW_REMINDERS_ENABLED=false
CRON_REVIEW_REMINDERS_SCHEDULE=0 * * * *
CRON_COMMITMENT_CHASE_ENABLED=false
CRON_COMMITMENT_CHASE_SCHEDULE=0 6 * * *

# Levy Exchange crons (worker only, Phase S)
CRON_LEVY_EXPIRY_ALERTS_ENABLED=false
CRON_LEVY_EXPIRY_ALERTS_SCHEDULE=0 8 * * *
CRON_LEVY_TRANSFER_STATUS_ENABLED=false
CRON_LEVY_TRANSFER_STATUS_SCHEDULE=0 3 * * *

# GDPR data retention cron (worker only, Phase U)
RETENTION_AUDIT_YEARS=7
RETENTION_SOFT_DELETE_DAYS=90
RETENTION_NOTIFICATION_DAYS=365
CRON_RETENTION_ENABLED=false
CRON_RETENTION_SCHEDULE=0 4 * * 0

# Platform ops (API only). Requires X-Platform-Ops-Api-Key header.
# GDPR erasure: POST /api/v1/platform/gdpr/erasure
# Retention runs: GET/POST /api/v1/platform/retention/runs|run — see docs/gdpr-retention.md
PLATFORM_OPS_ENABLED=false
PLATFORM_OPS_API_KEY=

# Portfolio KSB heatmap Redis cache TTL (0 = disabled)
PORTFOLIO_HEATMAP_CACHE_TTL_SECONDS=0

# Ofsted EIF readiness score Redis cache TTL (0 = disabled; default 1h)
EIF_SCORE_CACHE_TTL_SECONDS=3600

# Outbound push for withdrawal completion lifecycle
WITHDRAWAL_PUSH_ENDPOINT_URL=

# ILR ESFA submit client (noop = local/e2e default; http = OAuth REST stub)
ILR_ESFA_PROVIDER=noop
ILR_ESFA_BASE_URL=
ILR_ESFA_TOKEN_URL=
ILR_ESFA_CLIENT_ID=
ILR_ESFA_CLIENT_SECRET=
ILR_ESFA_SCOPE=
ILR_ESFA_SUBMIT_PATH=/api/v1/ilr/submit
ILR_ESFA_TIMEOUT_MS=15000
# json | xml — xml is the wire format when ILR_ESFA_PROVIDER=http
ILR_ESFA_PAYLOAD_FORMAT=xml
# Allow owner/admin to publish new ILR mapping config drafts
ILR_CONFIG_WRITE_ENABLED=false

# FlowPortal registration — Companies House lookup (noop when unset)
COMPANIES_HOUSE_API_KEY=
