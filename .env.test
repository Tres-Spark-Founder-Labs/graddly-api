PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_MIGRATION_USERNAME=postgres
# Must match the CI workflow's postgres service (POSTGRES_PASSWORD: postgres).
# An empty value is not "no password": pg's ConnectionParameters drops the
# empty string, the driver then sends `undefined` into the SCRAM handshake, and
# global-setup dies with "client password must be a string" before a single
# test runs. CI never saw it because ci.yml sets this variable explicitly.
DB_MIGRATION_PASSWORD=postgres
DB_USERNAME=graddly_app
DB_PASSWORD=graddly_app
DB_NAME=graddly_test

JWT_SECRET=test-jwt-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6380

THROTTLE_ENABLED=false

TENANT_DB_CONTEXT_ENABLED=true

OIDC_ENABLED=false

EMAIL_PROVIDER=noop
FRONTEND_BASE_URL=http://localhost:3001

QUEUE_OPS_ENABLED=true
QUEUE_OPS_API_KEY=test-queue-ops-api-key-min-32-chars!!

# Local runs must match CI, which has no .env file. Without this, dotenv/config
# in data-source.ts leaks STORAGE_PROVIDER=s3 from .env into the test process
# and five suites fail with NoSuchKey for an environment reason.
STORAGE_PROVIDER=noop
