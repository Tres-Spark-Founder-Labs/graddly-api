# Copy to load/k6/.env.local or run: yarn load:setup
# Requires: brew install k6, API running, Postgres + Redis up
#
# Local tips:
# - Port 3000 may be occupied; use PORT=3010 for the API and set BASE_URL below
# - Disable API throttling for load tests: THROTTLE_ENABLED=false when starting the API
BASE_URL=http://localhost:3010
TEST_EMAIL=
TEST_PASSWORD=
ORG_ID=
