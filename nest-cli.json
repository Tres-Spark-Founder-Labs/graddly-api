{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "ofsted/config/**/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "otj/config/**/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "levy-exchange/config/**/*.json",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ],
    "deleteOutDir": false,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  }
}
